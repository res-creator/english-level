{
  "name": "@english-level/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p qa/tsconfig.json",
    "test": "node --test test/*.test.ts",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "qa": "node --experimental-strip-types qa/run.ts",
    "qa:authenticated": "node --experimental-strip-types qa/run-authenticated.ts",
    "qa:audit-a1": "node --experimental-strip-types qa/audit-a1.ts"
  },
  "dependencies": {
    "@english-level/contracts": "workspace:*",
    "@english-level/shared": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "1.44.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "^3.80.0"
  }
}
