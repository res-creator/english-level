# Read by `vite build --mode preview` (see apps/web/wrangler.toml and
# docs/deployment.md). Not a secret — just the preview API Worker's public
# URL, which is only knowable after that Worker is first deployed. Replace
# the placeholder below with the real https://english-level-api-preview...
# workers.dev URL once it exists.
VITE_API_BASE_URL=https://REPLACE_WITH_PREVIEW_API_WORKER_URL.workers.dev
