# Base URL of the backend API.
# Local:      http://localhost:8787 (default if unset, see .env.development)
# Preview:    set in .env.preview, read by `vite build --mode preview`
# Production: set in .env.production, read by `vite build` (default mode)
# See docs/deployment.md.
VITE_API_BASE_URL=http://localhost:8787
