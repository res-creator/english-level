{
  "name": "@english-level/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "node --test test/*.test.ts",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:preview": "wrangler d1 migrations apply DB --env preview",
    "migrate:production": "wrangler d1 migrations apply DB --env production",
    "seed:generate": "node --experimental-strip-types scripts/generateSeedSql.ts"
  },
  "dependencies": {
    "@english-level/contracts": "workspace:*",
    "@english-level/shared": "workspace:*",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
